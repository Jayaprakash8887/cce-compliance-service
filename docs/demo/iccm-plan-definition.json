{
  "resourceType": "PlanDefinition",
  "id": "iccm-danger-signs-referral",
  "url": "http://openphc.org/PlanDefinition/iccm-danger-signs-referral",
  "version": "1.0.0",
  "name": "ICCMDangerSignsReferralProtocol",
  "title": "ICCM Danger Signs Assessment & Referral Protocol",
  "status": "active",
  "date": "2026-05-01",
  "description": "Tracks ICCM community case management workflow: CHW assesses child for danger signs via SPICE, generates referral ServiceRequest to OpenMRS clinic when urgent care is needed. Intelligence actions fire on urgent referrals to notify the receiving facility via OpenMRS.",
  "action": [
    {
      "id": "iccm-assessment",
      "title": "ICCM Assessment Encounter",
      "description": "Enrollment trigger — CHW completes ICCM assessment in SPICE. Matches Encounter with identifier encounter-type=ICCM. Uses FHIRPath condition since SPICE encodes encounter type in identifier[] rather than type.coding[].",
      "trigger": [
        {
          "type": "named-event",
          "name": "iccm-encounter-trigger",
          "data": [
            {
              "type": "Encounter"
            }
          ],
          "condition": {
            "language": "text/fhirpath",
            "expression": "Encounter.identifier.where(system='http://host.docker.internal:8090/fhir/encounter-type' and value='ICCM').exists()"
          }
        }
      ],
      "requiredBehavior": "must",
      "relatedAction": [
        {
          "actionId": "iccm-referral",
          "relationship": "after-start",
          "offsetDuration": {
            "value": 0,
            "unit": "d",
            "system": "http://unitsofmeasure.org",
            "code": "d"
          }
        }
      ],
      "timingTiming": {
        "repeat": {
          "count": 1,
          "frequency": 1,
          "period": 1,
          "periodUnit": "d"
        }
      }
    },
    {
      "id": "iccm-referral",
      "title": "ICCM Referral ServiceRequest",
      "description": "Referral generated by SPICE when ICCM danger signs are detected. Matches ServiceRequest with identifier encounter-type=ICCM. Intelligence sub-actions fire when priority is 'urgent' to escalate to OpenMRS.",
      "trigger": [
        {
          "type": "named-event",
          "name": "iccm-referral-trigger",
          "data": [
            {
              "type": "ServiceRequest"
            }
          ],
          "condition": {
            "language": "text/fhirpath",
            "expression": "ServiceRequest.identifier.where(system='http://host.docker.internal:8090/fhir/encounter-type' and value='ICCM').exists()"
          }
        }
      ],
      "requiredBehavior": "must",
      "timingTiming": {
        "repeat": {
          "count": 1,
          "frequency": 1,
          "period": 1,
          "periodUnit": "d"
        }
      },
      "extension": [
        {
          "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
          "valueInteger": 1
        }
      ],
      "action": [
        {
          "id": "urgent-referral-escalation",
          "title": "Urgent ICCM Referral Escalation",
          "description": "When the referral is marked urgent (danger signs detected), escalate to OpenMRS facility for immediate attention.",
          "condition": [
            {
              "kind": "applicability",
              "expression": {
                "language": "text/jsonlogic",
                "expression": "{\"==\": [{\"var\": \"event.priority\"}, \"urgent\"]}"
              }
            }
          ],
          "definitionCanonical": "http://openphc.org/ActivityDefinition/iccm-urgent-escalation|1.0.0",
          "extension": [
            {
              "url": "http://openphc.org/fhir/StructureDefinition/intelligence-severity",
              "valueCode": "CRITICAL"
            },
            {
              "url": "http://openphc.org/fhir/StructureDefinition/intelligence-destination",
              "valueCode": "OPENMRS"
            }
          ]
        },
        {
          "id": "routine-referral-notification",
          "title": "Routine ICCM Referral Notification",
          "description": "For non-urgent referrals, send a notification to the receiving facility.",
          "condition": [
            {
              "kind": "applicability",
              "expression": {
                "language": "text/jsonlogic",
                "expression": "{\"!=\": [{\"var\": \"event.priority\"}, \"urgent\"]}"
              }
            }
          ],
          "definitionCanonical": "http://openphc.org/ActivityDefinition/iccm-routine-notification|1.0.0",
          "extension": [
            {
              "url": "http://openphc.org/fhir/StructureDefinition/intelligence-severity",
              "valueCode": "MEDIUM"
            },
            {
              "url": "http://openphc.org/fhir/StructureDefinition/intelligence-destination",
              "valueCode": "OPENMRS"
            }
          ]
        }
      ]
    }
  ]
}
